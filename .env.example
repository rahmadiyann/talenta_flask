# Talenta API Configuration
# Copy this file to .env and fill in your values

# Authentication Methods:
# Method 1 (Recommended): Use email and password for automatic authentication
EMAIL=your.email@company.com
PASSWORD=yourpassword

# Method 2 (Fallback): Use manual cookies from browser
COOKIES_TALENTA=

# Location settings (fallback if auto-detection fails)
LONGITUDE=107.000
LATITUDE=-6.000

# Schedule settings (for scheduler.py)
TIME_CLOCK_IN=09:00
TIME_CLOCK_OUT=17:00

# Timezone setting (default: Asia/Jakarta / GMT+7)
TZ=Asia/Jakarta

# Telegram notification settings (optional)
# Get bot token from @BotFather on Telegram
# Get chat ID by messaging your bot and visiting: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Port settings (optional - automatically set by cloud platforms like Railway)
# For local development, defaults to 5000 if not specified
# PORT=5000

# Shift/Schedule checking settings
# Enables shift-aware clock in/out (skip on holidays, WFO notifications, etc.)
#
# How to get these values:
# 1. Open https://hr.talenta.co and go to your attendance page
# 2. Open DevTools (F12) → Network tab
# 3. Look for requests to "summary_attendance_clocks"
# 4. From the URL, copy the organisation ID and user ID:
#    Example: .../organisations/2767/summary_attendance_clocks?...&organisation_user_id=3939862
#    - MEKARI_ORGANISATION_ID = 2767
#    - MEKARI_ORGANISATION_USER_ID = 3939862
#
# Note: The Bearer token is automatically extracted from your login session.
# You don't need to set MEKARI_BEARER_TOKEN unless auto-extraction fails.
MEKARI_ORGANISATION_ID=
MEKARI_ORGANISATION_USER_ID=

# OPTIONAL: Manual Bearer token (only needed if automatic extraction fails)
# The app automatically extracts the Bearer token from your login session.
# Only set this if you see "Could not fetch schedule" errors.
MEKARI_BEARER_TOKEN=